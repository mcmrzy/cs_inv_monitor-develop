/**
 * worldGeo — 精简世界地图轮廓数据（等距柱状投影）
 *
 * 每个多边形为一组 [经度, 纬度] 坐标（东经为正、西经为负、北纬为正、南纬为负），
 * 闭合路径（首尾相连）。精度约为 Natural Earth 110m 的简化版，
 * 用于在离屏 Canvas 上生成真实地球纹理，无需外部图片与网络依赖。
 */

export type LatLon = [number, number]

/**
 * buildGlobeTextureDataURL — 用大洲轮廓数据在离屏 Canvas 上绘制
 * 等距柱状地球贴图（海洋渐变 + 大洲陆地 + 海岸线 + 淡经纬网格），
 * 返回 dataURL 供 echarts-gl globe.baseTexture 使用。
 */
export function buildGlobeTextureDataURL(texW = 2048, texH = 1024): string | null {
  const tex = document.createElement('canvas')
  tex.width = texW
  tex.height = texH
  const ctx = tex.getContext('2d')
  if (!ctx) return null

  // 海洋：中心亮、四周暗的深蓝渐变
  const ocean = ctx.createRadialGradient(texW * 0.5, texH * 0.42, texH * 0.1, texW * 0.5, texH * 0.5, texW * 0.62)
  ocean.addColorStop(0, '#0d4a86')
  ocean.addColorStop(0.5, '#083263')
  ocean.addColorStop(1, '#041a38')
  ctx.fillStyle = ocean
  ctx.fillRect(0, 0, texW, texH)

  // 经纬网格（淡青）
  ctx.strokeStyle = 'rgba(120,210,255,0.09)'
  ctx.lineWidth = 1
  for (let lon = -180; lon <= 180; lon += 30) {
    const x = ((lon + 180) / 360) * texW
    ctx.beginPath()
    ctx.moveTo(x, 0)
    ctx.lineTo(x, texH)
    ctx.stroke()
  }
  for (let lat = -90; lat <= 90; lat += 30) {
    const y = ((90 - lat) / 180) * texH
    ctx.beginPath()
    ctx.moveTo(0, y)
    ctx.lineTo(texW, y)
    ctx.stroke()
  }

  // 大洲陆地：北纬偏青绿、赤道深绿、南纬偏褐的垂直渐变
  const land = ctx.createLinearGradient(0, 0, 0, texH)
  land.addColorStop(0, 'rgba(148,186,132,0.92)')
  land.addColorStop(0.32, 'rgba(92,146,94,0.95)')
  land.addColorStop(0.52, 'rgba(72,128,84,0.96)')
  land.addColorStop(0.75, 'rgba(108,132,86,0.95)')
  land.addColorStop(1, 'rgba(196,206,196,0.95)')
  ctx.fillStyle = land
  ctx.strokeStyle = 'rgba(140,230,180,0.55)'
  ctx.lineWidth = 1.6
  ctx.lineJoin = 'round'

  for (const poly of WORLD_POLYGONS) {
    if (poly.length < 3) continue
    ctx.beginPath()
    for (let i = 0; i < poly.length; i++) {
      const [lon, lat] = poly[i]
      const x = ((lon + 180) / 360) * texW
      const y = ((90 - lat) / 180) * texH
      if (i === 0) ctx.moveTo(x, y)
      else ctx.lineTo(x, y)
    }
    ctx.closePath()
    ctx.fill()
    ctx.stroke()
  }

  return tex.toDataURL('image/png')
}

