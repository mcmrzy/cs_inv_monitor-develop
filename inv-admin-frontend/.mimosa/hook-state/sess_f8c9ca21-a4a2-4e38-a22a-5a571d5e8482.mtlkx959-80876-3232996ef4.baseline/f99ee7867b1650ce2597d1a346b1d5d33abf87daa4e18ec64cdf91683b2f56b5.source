  id: string
  /** @ant-design/icons 图标在 ModuleIcons 中按 id 映射，避免本文件依赖 React */
  nameKey: string
  descKey: string
  accent: string
  /** 模块内参数键（展示顺序） */
  paramKeys: string[]
  /** 首页卡片摘要取值的参数键（按顺序取前 2 个可读值） */
  summaryKeys: string[]
}

