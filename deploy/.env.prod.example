# ============================================================
# cs_inv_monitor - Production Environment Variables
# Copy to .env.prod on the deployment host. Never commit the populated file.
# ============================================================

# ---------- Database ----------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=inv_mqtt

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ---------- Internal Communication ----------
INTERNAL_KEY=CHANGE_ME_INTERNAL_SECRET

# ---------- Device PIN ----------
# 设备 PIN 派生密钥，必须与固件编译常量/工厂铭牌工具一致（缺省时云端绑定全部拒绝）
PRODUCT_SECRET=CS_INV_L10_2026_SECRET

# ---------- MQTT Broker (External EMQX) ----------
MQTT_BROKER=mqtt.example.com
MQTT_PORT=8883
MQTT_CLIENT_ID=CSKJ-INV-SERVER-DEVICE
MQTT_USERNAME=CSKJ-INV-DEVICE-SERVER
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_TLS_SKIP_VERIFY=false

# ---------- Kafka (in-stack KRaft broker) ----------
# The production compose overrides this to kafka:29092 for every application container.
KAFKA_BROKER=kafka:29092
KAFKA_ENABLED=true
KAFKA_TELEMETRY_TOPIC=inv-telemetry
KAFKA_ALARM_TOPIC=inv-alerts
KAFKA_COMMAND_TOPIC=inv-commands

# ---------- Backend URLs ----------
API_SERVER_URL=http://inv-api-server:8080
DEVICE_SERVER_URL=http://inv-device-server:8081

# ---------- 外部访问域名（多子域 CDN 模式）----------
# SERVER_URL: API 对外访问地址（上传文件返回 URL 等）
# DOWNLOAD_URL: 设备固件下载域（构造 OTA 命令里的 url），为空时回退 SERVER_URL
# FRONTEND_URL: 管理后台 Web 访问地址（邀请邮件链接等）
SERVER_URL=https://api.jiuxiaoyw.online
# 必须用 DNS 直连源站的根域 https://jiuxiaoyw.online（2026-09-09/10 实测两轮）：
#  - ESA 前置的 download. 子域会把固件响应改成 chunked（无 Content-Length，
#    ESP32 fetch_headers 拿到 -1 直接 HTTP_ERROR）；
#  - 且设备侧对 ESA 节点直接连接失败（ESP_ERR_HTTP_CONNECT）。
# 根域 /firmware/ 已由 nginx 反代到 api-gateway（见 deploy/nginx-proxy.conf），
# 并返回 immutable 缓存头；App 下载页放在根路径同样可用（直连源站）。
# 部署后校验：GET /firmware/<真实文件> 应 200 + Content-Length，Range 应 206。
#
# 注意：本变量只影响「机器读取的文件地址」。面向人的 App 下载页仍然托管在
# download.jiuxiaoyw.online（浏览器访问，ESA 前置无妨），不要为了页面把它改回子域。
DOWNLOAD_URL=https://jiuxiaoyw.online
FRONTEND_URL=https://www.jiuxiaoyw.online

# ---------- Email ----------
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=CHANGE_ME_EMAIL_AUTH_CODE
EMAIL_FROM=

# ---------- SMS (optional) ----------
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE=

# ---------- JPush (极光推送) ----------
JPUSH_ENABLED=false
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_TIMEOUT=10
JPUSH_DEDUP_TTL=120

# ---------- Deployment ----------
# Use an immutable image tag (normally the Git commit SHA), never "latest".
IMAGE_TAG=CHANGE_ME_GIT_COMMIT_SHA
