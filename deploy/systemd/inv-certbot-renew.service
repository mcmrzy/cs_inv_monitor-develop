[Unit]
Description=Renew CS Inv Monitor TLS certificates and reload containerized Nginx
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/etc/letsencrypt/renewal

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --quiet --no-random-sleep-on-renew
ExecStartPost=/usr/bin/docker exec inv-nginx nginx -t
ExecStartPost=/usr/bin/docker exec inv-nginx nginx -s reload
