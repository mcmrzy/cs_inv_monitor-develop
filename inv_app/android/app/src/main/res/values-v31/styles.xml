<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) 系统级 SplashScreen：
         品牌渐变背景（与 SplashPage 一致）+ 透明图标，
         原生屏无缝衔接 SplashPage，感知为一段开屏画面 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- 启动屏背景直接绘制开屏图（bitmap 全屏拉伸，与 Flutter 开屏页同一张图）；
             windowBackground 为开屏图顶部主色纯色兜底：bitmap 背景在个别设备被忽略时
             回退淡蓝且不露白/黑 -->
        <item name="android:windowBackground">#6EABE4</item>
        <item name="android:windowSplashScreenBackground">@drawable/splash_background_image</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
