<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="20dp"
        >
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_country_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/spinner_list_item"
            />
<!--        <android.support.v7.widget.AppCompatImageView-->
<!--            android:layout_width="20dp"-->
<!--            android:layout_height="20dp"-->
<!--            android:scaleType="centerInside"-->
<!--            android:id="@+id/iv_icon_down"-->
<!--            android:src="@drawable/icon_down"-->
<!--            android:layout_toRightOf="@id/spinner_country_selector"-->
<!--            />-->
        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/et_phone_number"
            android:layout_toRightOf="@id/spinner_country_selector"
            android:hint="请输入手机号码"
            android:layout_marginLeft="40dp"
            android:background="@null"
            android:textSize="@dimen/major_text_size"
            android:inputType="phone"
            />
        <View
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/spinner_country_selector"
            android:background="#D8D8D8"
            android:layout_marginTop="5dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="验证码"
            android:id="@+id/tv_verify_code"
            android:layout_below="@id/line1"
            android:layout_marginTop="20dp"
            android:textSize="@dimen/major_text_size"
            />
        <com.nirvana.prd.sms.demo.widget.VerifyCodeTimerWidget
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@id/line1"
            android:layout_marginTop="20dp"
            android:id="@+id/btn_send_verify_code"
            android:textSize="@dimen/second_text_size"
            tools:textColor="#1890FF"
            tools:text="获取验证码"
            />
        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/et_verify_code"
            android:layout_alignLeft="@id/et_phone_number"
            android:layout_below="@id/line1"
            android:layout_marginTop="20dp"
            android:layout_toLeftOf="@id/btn_send_verify_code"
            android:hint="请输入验证码"
            android:textSize="@dimen/major_text_size"
            android:background="@null"
            android:inputType="number"
            />
        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/tv_verify_code"
            android:background="#D8D8D8"
            android:layout_marginTop="5dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_error_tip"
            android:textColor="#FF0000"
            android:text="验证码错误"
            android:textSize="12dp"
            android:layout_below="@id/line2"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            />
        
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/line2"
            android:layout_marginTop="50dp"
            android:id="@+id/btn_login"
            android:text="登录"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:background="@drawable/drawable_button_background"
            android:textSize="@dimen/major_btn_text_size"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_below="@id/btn_login"
            android:gravity="center_vertical"
            >
            <CheckBox
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:id="@+id/ck_protocol"
                android:background="@drawable/drawable_checkbox_icon"
                android:button="@null"
                tools:checked="true"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_protocol"
                tools:text="同意《用户隐私协议》"
                android:layout_marginLeft="5dp"
                android:textSize="@dimen/second_text_size"
                />
        </LinearLayout>


    </RelativeLayout>
</FrameLayout>