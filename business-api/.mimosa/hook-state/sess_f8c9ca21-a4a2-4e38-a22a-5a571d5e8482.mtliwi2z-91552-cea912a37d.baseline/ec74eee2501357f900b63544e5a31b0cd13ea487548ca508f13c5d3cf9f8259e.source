			req.Header.Set("Content-Type", "application/json")
			w := httptest.NewRecorder()

			r.ServeHTTP(w, req)

			assertResponseCode(t, w, tt.wantStatus)
		})
	}
}
func TestInternalDeviceData_Validation(t *testing.T) {
	r := setupTestRouter()

	tests := []struct {
